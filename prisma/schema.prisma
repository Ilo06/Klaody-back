generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  files        File[]
}

model File {
  id         Int       @id @default(autoincrement())
  name       String
  mimeType   String
  size       BigInt
  storedName String    @unique // generated filename on disk under FILE_ROOT — never the user-supplied name
  folderId   Int?      // will reference Folder once that model exists; null = root
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime? // soft delete / trash marker

  @@index([userId])
}

// Additional models (Folder, ShareLink) will be added later.
