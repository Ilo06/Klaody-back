generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IndexStatus {
  NONE    // not an indexable image (or too large)
  PENDING // queued for CLIP embedding
  DONE    // embedding stored, searchable
  FAILED  // gave up after retries; re-run the backfill script to retry
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  files        File[]
  folders      Folder[]
}

model Folder {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  parentId  String?   @db.Uuid // null = root
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]  @relation("FolderTree")
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     File[]
  createdAt DateTime  @default(now())
  deletedAt DateTime? // soft delete / trash marker (shared by the whole trashed subtree)

  @@index([userId, parentId])
}

model File {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  mimeType   String
  size       BigInt
  storedName String      @unique // generated filename on disk under FILE_ROOT — never the user-supplied name
  folderId   String?     @db.Uuid // null = root
  folder     Folder?     @relation(fields: [folderId], references: [id])
  userId     String      @db.Uuid
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadedAt DateTime    @default(now())
  deletedAt  DateTime?   // soft delete / trash marker
  shareLinks ShareLink[]
  indexStatus IndexStatus @default(NONE) // CLIP indexing state, images only
  embedding   ImageEmbedding?

  @@index([userId])
  @@index([folderId])
}

model ShareLink {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique // URL-safe random token, the public identifier in /share/:token
  fileId    String    @db.Uuid
  file      File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  expiresAt DateTime? // null = never expires
  createdAt DateTime  @default(now())

  @@index([fileId])
}

// CLIP image embedding used by GET /files/search.
// Written and queried with raw SQL only (Prisma cannot read/write pgvector columns natively).
model ImageEmbedding {
  fileId    String   @id @db.Uuid
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(512)")
  model     String
  createdAt DateTime @default(now())
}
