# Environment variables for Klaody backend
# -----------------------------------------------------------------
# PostgreSQL connection string (example)
DATABASE_URL=postgresql://user:password@localhost:5432/klaody

# JWT secret (use a long, random string in production)
JWT_SECRET=change-me-to-a-strong-secret

# Directory where uploaded files are stored (must exist & be writable)
FILE_ROOT=/srv/storage

# Server port (optional, defaults to 3000)
PORT=3000

# Storage reserve ratio (optional, defaults to 0.1)
STORAGE_RESERVE_RATIO=0.1

# --- Image search (CLIP + pgvector) ---------------------------------------------
# Optional: direct (non-pooled) Postgres URL for the pg-boss job queue. Defaults to DATABASE_URL.
# Set it if DATABASE_URL goes through a transaction pooler (e.g. Supabase port 6543).
# PGBOSS_DATABASE_URL=postgresql://user:password@localhost:5432/klaody

# Optional: where the CLIP model files are cached (~150 MB, downloaded on first start).
# CLIP_CACHE_DIR=/srv/storage/.models

# Optional: minimum cosine similarity for a search hit (default 0.2). Raise it for stricter results.
# SEARCH_MIN_SIMILARITY=0.2

# Optional: largest image (bytes) that gets indexed (default 52428800 = 50 MB).
# INDEX_MAX_BYTES=52428800
