# Environment variables for VDrive backend
# -----------------------------------------------------------------
# PostgreSQL connection string (example)
DATABASE_URL=postgresql://user:password@localhost:5432/vdrive

# JWT secret (use a long, random string in production)
JWT_SECRET=change-me-to-a-strong-secret

# Directory where uploaded files are stored (must exist & be writable)
FILE_ROOT=/srv/storage

# Server port (optional, defaults to 3000)
PORT=3000
